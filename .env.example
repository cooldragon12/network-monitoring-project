# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Django ---
DJANGO_SECRET_KEY=
# Off by default. Set true only for local development.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://monitor.example.lan (needed when served via a reverse proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Secure (HTTPS-only) cookies. Set false only for plain-HTTP local development.
DJANGO_SECURE_COOKIES=true
# Set true when running behind an HTTPS reverse proxy (Caddy etc.).
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_HSTS_SECONDS=0
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- Postgres (used by docker compose) ---
POSTGRES_USER=netmon
# Use a URL-safe value (hex), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=netmon

# --- Native (non-Docker) processes, e.g. the scanner worker on the host ---
# Docker services override these two to point at the db/redis containers.
# The password here must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://netmon:CHANGE_ME@localhost:5432/netmon
CELERY_BROKER_URL=redis://localhost:6379/0
# Shared cache (login rate limiting). locmem:// = per-process, for quick runs without Redis.
CACHE_URL=redis://localhost:6379/1

# --- LAN scanner (server side; the agent itself is configured in scanner.env) ---
# Default subnet for scanner agents (a host's own scan subnet overrides it).
# Empty = each agent auto-detects its LAN.
SCAN_SUBNET=192.168.31.0/24
# Interface for `manage.py scan_now` (local debugging only).
SCAN_INTERFACE=
SCAN_INTERVAL_MINUTES=2
OFFLINE_AFTER_MISSED_SCANS=3
SCAN_TIMEOUT_SECONDS=2
# How often scanner agents poll for work (Scan now latency).
SCANNER_HEARTBEAT_SECONDS=5
# Per-host rate limit on /api/agent/*.
AGENT_THROTTLE_RATE=120/min
# Only for `docker compose --profile scanner` (stack on a Linux host on the LAN):
NETMON_SCANNER_SERVER_URL=http://127.0.0.1:8000
NETMON_SCANNER_TOKEN=

# --- Web / links ---
# Address the web container is published on. 127.0.0.1 = this machine only.
# Set to this machine's LAN IP (and add it to DJANGO_ALLOWED_HOSTS) to use it from your phone.
WEB_BIND=127.0.0.1
# Base URL for links in notifications.
SITE_URL=http://127.0.0.1:8000

# --- Notifications ---
# Don't re-send the same alert kind for the same device/host within this many minutes.
NOTIFY_COOLDOWN_MINUTES=60
# Low-priority notifications for new randomized-MAC (phone privacy) devices.
NOTIFY_RANDOM_MAC=true

# --- ntfy (self-hosted, runs in docker compose) ---
NOTIFY_NTFY_ENABLED=false
# Used by native processes; Docker services override this to http://ntfy:80.
NOTIFY_NTFY_URL=http://127.0.0.1:8080
NOTIFY_NTFY_TOPIC=netmon-alerts
# Access token of the ntfy publisher user (see README "Notifications").
NOTIFY_NTFY_TOKEN=
# Address the ntfy server is published on, and the URL your phone uses to reach it.
NTFY_BIND=127.0.0.1
NTFY_PUBLIC_URL=http://127.0.0.1:8080
# Optional, iOS only: https://ntfy.sh for instant push (relays only a content-free poll nudge).
NTFY_UPSTREAM_BASE_URL=

# --- Email (optional notification channel) ---
NOTIFY_EMAIL_ENABLED=false
# Comma-separated recipients.
NOTIFY_EMAIL_TO=
# Console backend just logs emails. For SMTP use django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=network-monitor@localhost
