# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Django ---
DJANGO_SECRET_KEY=
# Off by default. Set true only for local development.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://monitor.example.lan (needed when served via a reverse proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Secure (HTTPS-only) cookies. Set false only for plain-HTTP local development.
DJANGO_SECURE_COOKIES=true
# Set true when running behind an HTTPS reverse proxy (Caddy etc.).
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_HSTS_SECONDS=0
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- Postgres (used by docker compose) ---
POSTGRES_USER=netmon
# Use a URL-safe value (hex), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=netmon

# --- Native (non-Docker) processes, e.g. the scanner worker on the host ---
# Docker services override these two to point at the db/redis containers.
# The password here must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://netmon:CHANGE_ME@localhost:5432/netmon
CELERY_BROKER_URL=redis://localhost:6379/0

# --- LAN scanner ---
# Subnet to scan. Empty = auto-detect on the scanner host.
SCAN_SUBNET=192.168.31.0/24
# Interface to scan on. Empty = default-route interface.
SCAN_INTERFACE=
SCAN_INTERVAL_MINUTES=2
OFFLINE_AFTER_MISSED_SCANS=3
SCAN_TIMEOUT_SECONDS=2

# --- Email (optional notification channel) ---
# Console backend just logs emails. For SMTP use django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=network-monitor@localhost
