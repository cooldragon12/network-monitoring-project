# LAN scanner agent configuration. Copy to scanner.env (gitignored) and fill in.
# Create the host in the dashboard (Hosts -> Add host, tick "LAN scanner"):
# the token is shown once.

# URL of the Network Monitor web app, as reachable from the scanner machine.
NETMON_SERVER_URL=http://192.168.31.234:8000
NETMON_TOKEN=
# Or read the token from a file instead:
# NETMON_TOKEN_FILE=/etc/netmon/scanner.token

# Optional: interface to scan on (default: the default-route interface).
NETMON_INTERFACE=
# Optional: auto | raw (Linux, lowest memory) | scapy | arp-scan
NETMON_BACKEND=auto
# Optional: CA bundle if the server uses HTTPS with a private CA (e.g. Caddy internal).
# NETMON_CA_FILE=/etc/netmon/caddy-root.crt
